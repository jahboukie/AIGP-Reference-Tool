{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "AI Technical Reference",
  "version": "0.1.0",
  "identifier": "com.ai-governance.technical-reference",
  "build": {
    "beforeDevCommand": "mdbook serve --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "mdbook build",
    "frontendDist": "../book"
  },
  "app": {
    "windows": [
      {
        "title": "AI Technical Reference",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
